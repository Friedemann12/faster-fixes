{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "DOMAIN_NAME",
        "DATABASE_URL",

        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BASE_URL",

        "NEXT_PUBLIC_STRIPE_PUBLIC_KEY",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SIGNING_SECRET",
        "STRIPE_DEFAULT_TAX_RATE_ID",
        "PRO_MONTHLY_PRICE_ID",
        "PRO_YEARLY_PRICE_ID",
        "AGENCY_MONTHLY_PRICE_ID",
        "AGENCY_YEARLY_PRICE_ID",

        "PLUNK_SECRET_KEY",
        "RESEND_API_KEY",
        "RESEND_SEGMENT_ID",

        "STORAGE_ENDPOINT",
        "STORAGE_REGION",
        "STORAGE_BUCKET_NAME",
        "STORAGE_ACCESS_KEY_ID",
        "STORAGE_SECRET_ACCESS_KEY",
        "STORAGE_PUBLIC_URL",

        "LINEAR_CLIENT_ID",
        "LINEAR_CLIENT_SECRET",
        "LINEAR_OAUTH_REDIRECT_URI",
        "LINEAR_WEBHOOK_SIGNING_SECRET",
        "LINEAR_TOKEN_ENCRYPTION_KEY",

        "JIRA_CLIENT_ID",
        "JIRA_CLIENT_SECRET",
        "JIRA_OAUTH_REDIRECT_URI",
        "JIRA_TOKEN_ENCRYPTION_KEY",
        "JIRA_WEBHOOK_BASE_URL",

        "SLACK_CLIENT_ID",
        "SLACK_CLIENT_SECRET",
        "SLACK_TOKEN_ENCRYPTION_KEY",

        "GITHUB_APP_ID",
        "GITHUB_PRIVATE_KEY",
        "GITHUB_WEBHOOK_SECRET",

        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY",
        "INNGEST_BASE_URL",

        "FF_API_KEY",
        "FF_API_ORIGIN",
        "NEXT_PUBLIC_IS_CLOUD"
      ]
    }
  }
}
