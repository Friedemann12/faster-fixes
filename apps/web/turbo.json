{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NODE_ENV",
        "DOMAIN_NAME",
        "DATABASE_URL",

        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BASE_URL",

        "SIGNUP_ALLOWED_EMAILS",

        "STORAGE_ENDPOINT",
        "STORAGE_REGION",
        "STORAGE_BUCKET_NAME",
        "STORAGE_ACCESS_KEY_ID",
        "STORAGE_SECRET_ACCESS_KEY",

        "GITHUB_APP_NAME",
        "GITHUB_APP_ID",
        "GITHUB_PRIVATE_KEY",
        "GITHUB_WEBHOOK_SECRET",

        "LINEAR_CLIENT_ID",
        "LINEAR_CLIENT_SECRET",
        "LINEAR_OAUTH_REDIRECT_URI",
        "LINEAR_WEBHOOK_SIGNING_SECRET",
        "LINEAR_TOKEN_ENCRYPTION_KEY",

        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY",
        "INNGEST_BASE_URL",

        "FF_API_KEY",
        "FF_API_ORIGIN"
      ]
    }
  }
}
