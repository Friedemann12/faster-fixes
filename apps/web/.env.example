DOMAIN_NAME="example.com"
BASE_URL=http://localhost:3000

DATABASE_URL="postgresql://username:password@host:5432/database_name?schema=public"

# ---------------------
# 
# AUTHENTICATION
# 
# ---------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app

# ---------------------
#
# STORAGE (MinIO / any S3-compatible)
#
# ---------------------
STORAGE_ENDPOINT="http://localhost:9000"      # MinIO S3 API endpoint reachable from the server
STORAGE_REGION="us-east-1"
STORAGE_BUCKET_NAME="fasterfixes"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Public base URL of the bucket (browser-facing), e.g. https://s3.example.com/fasterfixes
STORAGE_PUBLIC_URL="http://localhost:9000/fasterfixes"

# ---------------------
#
# FEEDBACK WIDGET
#
# ---------------------
FF_API_KEY=""
FF_API_ORIGIN=http://localhost:3000

# ---------------------
#
# GITHUB APP
#
# ---------------------
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=          # Full PEM content with \n as literal newlines
GITHUB_WEBHOOK_SECRET=       # High-entropy random string for webhook signature verification

# ---------------------
#
# LINEAR INTEGRATION
#
# ---------------------
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_OAUTH_REDIRECT_URI=    # Optional override; defaults to $BETTER_AUTH_URL/api/linear/callback
LINEAR_WEBHOOK_SIGNING_SECRET= # App-level webhook secret from Linear's OAuth app settings
LINEAR_TOKEN_ENCRYPTION_KEY=   # 32-byte hex (generate via `openssl rand -hex 32`); rotation = full re-encrypt migration


# ---------------------
#
# INNGEST
#
# ---------------------
INNGEST_EVENT_KEY=           # Required in production for event authentication
INNGEST_SIGNING_KEY=         # Required in production for webhook signature verification
INNGEST_BASE_URL=

# ---------------------
#
# ADMIN SETUP
#
# ---------------------
SIGNUP_ALLOWED_EMAILS=